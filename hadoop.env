# Core Hadoop config (becomes core-site.xml)
CORE_CONF_fs_defaultFS=hdfs://namenode:9000
CORE_CONF_hadoop_http_staticuser_user=root

# HDFS config (becomes hdfs-site.xml)
# dfs.replication is deliberately left at the Hadoop default (3) here.
# We only have 2 DataNodes, so uploads at the default will show as
# under-replicated in fsck -- that's intentional, it's part of the evidence
# for why replication=2 is the right explicit choice for this cluster.
HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_permissions_enabled=false
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false
